 120   1              uint16_t lenstr=0;
 121   1              int8_t str[8];
 122   1              int8_t pom[8];
 123   1              while(broj!=0){
 124   2                      ostatak=broj%10;        //cuva posljednju cifru broja
 125   2                      broj=broj/10;   
 126   2                      pom[i]=ostatak+48;
 127   2                      len++;
 128   2                      i++;
 129   2              }
 130   1              pom[len]='\0';
 131   1              lenstr=len;
 132   1              j=len-1;
 133   1              for(i=0; i<lenstr; i++, j--){
 134   2                      str[i]=pom[j];
 135   2              }
 136   1              str[lenstr]='\0';
 137   1              return str;
 138   1      }
