 200          bit getbit(uint8_t n, uint8_t k)        // funkcija koja vraca bit koji se nalazi na poziciji n
 201          {
 202   1              uint8_t mask = 1 << k;    // ova funkcija se koristi za ispisivanje karaktera na lcd
